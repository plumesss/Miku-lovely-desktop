{
  "name": "miku-desk-pet",
  "version": "0.1.1",
  "description": "初音桌宠 Windows 版",
  "author": "MikuDeskPet",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer.js && node --check settings.js",
    "smoke": "electron . --smoke-test",
    "build:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.miku.deskpet.windows",
    "productName": "初音桌宠",
    "asar": true,
    "directories": {
      "output": "../dist/windows"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer.js",
      "settings.js",
      "*.html",
      "*.css",
      "assets/**/*",
      "!assets/sounds/**/*",
      "!assets/**/*.m4a",
      "!assets/**/*.wav",
      "!assets/**/*.mp3",
      "!assets/**/*.ogg",
      "!assets/**/*.icns"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "app.ico",
      "signAndEditExecutable": false,
      "artifactName": "MikuDeskPet-${version}-Windows-x64-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "初音桌宠",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "license": "NOTICE.txt"
    }
  }
}
